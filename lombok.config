# Applies to every module: Lombok reads this file from each source file's directory upwards.
config.stopBubbling = true

# jackson-annotations 2.20+ is shared by Jackson 2 and 3, so Lombok can't tell which one @Jacksonized targets.
# Spring Boot 4 maps JSON with Jackson 3, and since swagger-core 3 nothing reads the DTOs with Jackson 2 any more.
lombok.jacksonized.jacksonVersion += 3
